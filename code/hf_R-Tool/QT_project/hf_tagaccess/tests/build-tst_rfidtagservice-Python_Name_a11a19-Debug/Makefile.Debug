install_target: first FORCE
	@if not exist D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice mkdir D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice & if not exist D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice\$(TARGET)
	-$(INSTALL_FILE) debug\tst_rfidtagservice.pdb D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice\tst_rfidtagservice.pdb

uninstall_target: FORCE
	-$(DEL_FILE) D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice\$(TARGET) 
	 -$(DEL_FILE) D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice\tst_rfidtagservice.pdb
	-$(DEL_DIR) D:$(INSTALL_ROOT)\QT5\5.14.2\msvc2017\tests\rfidtagservice 


